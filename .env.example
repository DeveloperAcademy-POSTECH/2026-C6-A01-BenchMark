# Copy to apps/web/.env.local for Next.js. Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/benchmark
APP_ORIGIN=http://localhost:3000
# Keep test mode until collection purpose, retention and contact are approved.
REGISTRATION_MODE=test
# Required for live collection only:
PRIVACY_RETENTION_DAYS=
PRIVACY_CONTACT_EMAIL=
